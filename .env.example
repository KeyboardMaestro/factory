# Supabase project URL and server-only secret key. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public Kakao JavaScript key (optional; native share and copy remain available without it).
NEXT_PUBLIC_KAKAO_JS_KEY=

# Absolute production origin, e.g. https://example.vercel.app
APP_ORIGIN=http://localhost:3000

# Vercel Cron sends this as an Authorization Bearer header; use a random value of at least 16 characters.
CRON_SECRET=

# Optional secret for calling the same retention-cleanup endpoint via POST.
MAINTENANCE_SECRET=
